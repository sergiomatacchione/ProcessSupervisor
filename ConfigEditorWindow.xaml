<Window x:Class="ProcessSupervisor.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifica configurazione" Height="600" Width="1050"
        MinHeight="380" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <DockPanel Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Aggiungi programma" Padding="12,6" Margin="8,0,0,0"
                            Click="Add_Click"/>
                    <Button Content="Rimuovi selezionato" Padding="12,6" Margin="8,0,0,0"
                            Click="Remove_Click"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Le modifiche vengono salvate in apps_config.json accanto all'eseguibile."/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Cartella richieste in ingresso"
                           VerticalAlignment="Center" Margin="0,0,8,5"/>
                <TextBox x:Name="InboxDirectoryBox" Grid.Row="0" Grid.Column="1"
                         Margin="0,0,0,5" Padding="5"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Cartella richieste elaborate"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="ProcessedDirectoryBox" Grid.Row="1" Grid.Column="1"
                         Padding="5"/>
            </Grid>
        </StackPanel>

        <DataGrid x:Name="ConfigGrid" Grid.Row="1" ItemsSource="{Binding}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" Background="White"
                  BorderBrush="#D1D5DB" RowHeight="38"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="190"/>
                <DataGridTextColumn Header="Percorso eseguibile" Binding="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTemplateColumn Header="Sfoglia" Width="85">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Seleziona..." Padding="7,3" Click="Browse_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Argomenti" Binding="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                <DataGridTextColumn Header="Cartella di lavoro" Binding="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Width="190"/>
                <DataGridCheckBoxColumn Header="Riavvio crash" Binding="{Binding AutoRestartOnCrash}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Content="Ripristina valori predefiniti"
                    Padding="12,7" Click="Reset_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annulla" Padding="16,7" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Salva" Padding="18,7" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
