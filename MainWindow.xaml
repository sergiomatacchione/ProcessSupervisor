<Window x:Class="ProcessSupervisor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProcessSupervisor" Height="600" Width="1080"
        MinHeight="440" MinWidth="860"
        Background="#F3F4F6" FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#757575"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter Property="Background" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Starting">
                    <Setter Property="Background" Value="#F9A825"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Crashed">
                    <Setter Property="Background" Value="#C62828"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToggleButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
            <Setter Property="Content" Value="▶ Avvia"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Content" Value="⏹ Ferma"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Style="{StaticResource ToolButton}" Content="▶️ Avvia Tutti"
                    Command="{Binding StartAllCommand}"/>
            <Button Style="{StaticResource ToolButton}" Content="⏹️ Ferma Tutti"
                    Command="{Binding StopAllCommand}"/>
            <Button Style="{StaticResource ToolButton}" Content="🔄 Riavvia Tutti"
                    Command="{Binding RestartAllCommand}"/>
            <Button Style="{StaticResource ToolButton}" Content="📂 Ricarica Configurazione"
                    Command="{Binding ReloadConfigCommand}"/>
            <Button Style="{StaticResource ToolButton}" Content="⚙ Modifica Configurazione"
                    Click="OpenConfiguration_Click"/>
            <Button Style="{StaticResource ToolButton}" Content="📜 Log Scheduler"
                    Click="OpenSchedulerLog_Click"/>
        </StackPanel>

        <!-- Griglia processi -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Processes}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E5E7EB" BorderBrush="#D1D5DB"
                  RowHeight="40" SelectionMode="Single" Background="White">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="8,0" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Stato" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatusBadge}">
                                <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Applicazione" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Istanza" Binding="{Binding InstanceLabel}" Width="105"/>
                <DataGridTextColumn Header="Origine processo" Binding="{Binding OriginStatus}" Width="150"/>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid, TargetNullValue=—}" Width="70"/>
                <DataGridTextColumn Header="Avvio"
                                    Binding="{Binding StartTime, StringFormat=HH:mm:ss, TargetNullValue=—}"
                                    Width="80"/>
                <DataGridTextColumn Header="Uptime" Binding="{Binding UptimeText}" Width="100"/>
                <DataGridTextColumn Header="Crash" Binding="{Binding CrashCount}" Width="55"/>

                <DataGridTemplateColumn Header="Azioni" Width="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ToggleButton}"
                                        Command="{Binding DataContext.ToggleCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource RowButton}" Content="🔄 Riavvia"
                                        Command="{Binding DataContext.RestartCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- Log eventi -->
        <ListBox x:Name="LogList" Grid.Row="3" ItemsSource="{Binding LogEntries}"
                 FontFamily="Consolas" FontSize="12" BorderBrush="#D1D5DB"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
