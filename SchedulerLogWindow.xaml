<Window x:Class="ProcessSupervisor.SchedulerLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log MortiDiSonno Scheduler" Height="560" Width="900"
        MinHeight="360" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Aggiorna" Padding="12,6"
                    Click="Refresh_Click"/>
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="C:\Users\User\AppData\Roaming\MortiDiSonno\logs\scheduler.log"/>
        </DockPanel>
        <TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" Padding="8"
                 Background="White" BorderBrush="#D1D5DB"/>
    </Grid>
</Window>
